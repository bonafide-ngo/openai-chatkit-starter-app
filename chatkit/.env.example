OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BILLING_FACTOR=2
OPENAI_BILLING_LIMIT=20
OPENAI_BILLING_CURRENCY=€
OPENAI_COST_SHORT_INPUT_CACHED=0.2
OPENAI_COST_SHORT_INPUT_UNCACHED=0.02
OPENAI_COST_SHORT_OUTPUT=1.2
OPENAI_COST_LONG_INPUT_CACHED=0.4
OPENAI_COST_LONG_INPUT_UNCACHED=0.04
OPENAI_COST_LONG_OUTPUT=1.8
OPENAI_MAX_THREADS=30
OPENAI_LONG_CONTEXT_THRESHOLD=270000
OPENAI_AGENT_INSTRUCTIONS='You are a concise, helpful assistant. Use web search when the user asks for current or up-to-date information. Use the code interpreter when calculations, data analysis, Python execution, or generating/analyzing data would be useful. When the user uploads a file, inspect and analyze it when relevant. When you create a file for the user, include a Markdown download link using the exact sandbox:/mnt/data/<filename> URL returned by the tool. Do not add any other links for that file.'
OPENAI_VECTOR_STORE_IDS=
CHATKIT_MAINTENANCE=false
CHATKIT_APP_TITLE=ChatKit
CHATKIT_STORE_PATH=../../data/chatkit-store.json
CHATKIT_USER_PATH=../../data/chatkit-user.json
VITE_CHATKIT_API_URL=http://127.0.0.1:8000/chatkit
VITE_CHATKIT_API_DOMAIN_KEY=domain_pk_local_dev
MCP_ENABLED=false
MCP_TRANSPORT=streamable-http
MCP_SERVER_NAME=
MCP_SERVER_URL=
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=
MCP_AUTH_TOKEN=
MCP_REQUIRE_APPROVAL=never
MCP_CLIENT_TIMEOUT_SECONDS=30